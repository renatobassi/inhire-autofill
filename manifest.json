{
  "manifest_version": 3,
  "name": "InHire Autofill",
  "version": "0.2.0",
  "description": "Preenche a etapa Information das vagas em inhire.app com o perfil salvo no Chrome.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "InHire Autofill",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": ["https://*.inhire.app/*"],
      "js": ["src/content/fill.js"],
      "css": ["src/content/fill.css"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
